<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.isen.java2.view.PersonFormController"
            stylesheets="@../css/person-form.css"
            styleClass="form-container"
            minWidth="700" minHeight="550" maxHeight="650">
    
    <!-- TOP: Form Header -->
    <top>
        <VBox styleClass="form-header">
            <padding>
                <Insets top="24" right="24" bottom="16" left="24"/>
            </padding>
            <Label fx:id="formTitle" text="➕ Add Contact" styleClass="form-title"/>
            <Separator/>
        </VBox>
    </top>

    <!-- CENTER: Form Content -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20">
                <padding>
                    <Insets top="20" right="24" bottom="20" left="24"/>
                </padding>

                <!-- Two Column Layout: Info on Left, Photo on Right -->
                <HBox spacing="24">
                    
                    <!-- LEFT SIDE: All Form Fields -->
                    <VBox spacing="16" HBox.hgrow="ALWAYS">
                        
                        <!-- Personal Information -->
                        <TitledPane text="👤 Personal Information" expanded="true" collapsible="false">
                            <GridPane hgap="12" vgap="14">
                                <padding>
                                    <Insets top="16" right="16" bottom="16" left="16"/>
                                </padding>
                                
                                <Label text="First Name *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="firstNameField" promptText="Enter first name"
                                           GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

                                <Label text="Last Name *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="lastNameField" promptText="Enter last name"
                                           GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

                                <Label text="Nickname" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField fx:id="nicknameField" promptText="Optional"
                                           GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

                                <Label text="Birth Date" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <DatePicker fx:id="birthDatePicker" promptText="Select date"
                                            GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>
                                
                                <columnConstraints>
                                    <ColumnConstraints minWidth="90" prefWidth="100"/>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
                                </columnConstraints>
                            </GridPane>
                        </TitledPane>

                        <!-- Contact Information -->
                        <TitledPane text="📞 Contact Information" expanded="true" collapsible="false">
                            <GridPane hgap="12" vgap="14">
                                <padding>
                                    <Insets top="16" right="16" bottom="16" left="16"/>
                                </padding>
                                
                                <Label text="Phone" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="phoneField" promptText="+1 (555) 123-4567"
                                           GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

                                <Label text="Email" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="emailField" promptText="email@example.com"
                                           GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

                                <Label text="Address" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField fx:id="addressField" promptText="Street, City, Country"
                                           GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>
                                
                                <columnConstraints>
                                    <ColumnConstraints minWidth="90" prefWidth="100"/>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
                                </columnConstraints>
                            </GridPane>
                        </TitledPane>
                        
                    </VBox>

                    <!-- RIGHT SIDE: Photo Section -->
                    <VBox spacing="12" alignment="TOP_CENTER" styleClass="photo-section" minWidth="180" prefWidth="180">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <Label text="📷 Photo" styleClass="form-label"/>
                        <ImageView fx:id="photoView" fitHeight="140" fitWidth="140" 
                                   preserveRatio="true" styleClass="photo-preview"/>
                        <Button text="Choose Image" onAction="#handleSelectImage" 
                                styleClass="button-secondary" maxWidth="Infinity"/>
                    </VBox>

                </HBox>
                
            </VBox>
        </ScrollPane>
    </center>

    <!-- BOTTOM: Action Buttons -->
    <bottom>
        <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="form-actions">
            <padding>
                <Insets top="16" right="24" bottom="20" left="24"/>
            </padding>
            <Button text="✖ Cancel" onAction="#handleCancel" styleClass="button-secondary" minWidth="100"/>
            <Button fx:id="saveButton" text="💾 Save Contact" onAction="#handleSave" 
                    styleClass="button-success" minWidth="120"/>
        </HBox>
    </bottom>
    
</BorderPane>