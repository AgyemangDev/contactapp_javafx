<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.isen.java2.controller.PersonFormController"
      spacing="15" style="-fx-background-color: #FAFAFA;">
    
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label fx:id="formTitle" text="Add Person" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- Personal Info Section -->
    <TitledPane text="Personal Info" expanded="true">
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            
            <Label text="First Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="firstNameField" GridPane.rowIndex="0" GridPane.columnIndex="1" 
                       style="-fx-background-radius: 5px;"/>

            <Label text="Last Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="lastNameField" GridPane.rowIndex="1" GridPane.columnIndex="1" 
                       style="-fx-background-radius: 5px;"/>

            <Label text="Nickname:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="nicknameField" GridPane.rowIndex="2" GridPane.columnIndex="1" 
                       style="-fx-background-radius: 5px;"/>

            <Label text="Birth Date:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <DatePicker fx:id="birthDatePicker" GridPane.rowIndex="3" GridPane.columnIndex="1" 
                        style="-fx-background-radius: 5px;"/>
        </GridPane>
    </TitledPane>

    <!-- Contact Info Section -->
    <TitledPane text="Contact Info" expanded="true">
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            
            <Label text="Phone:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="phoneField" GridPane.rowIndex="0" GridPane.columnIndex="1" 
                       style="-fx-background-radius: 5px;"/>

            <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1" 
                       style="-fx-background-radius: 5px;"/>

            <Label text="Address:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="addressField" GridPane.rowIndex="2" GridPane.columnIndex="1" 
                       style="-fx-background-radius: 5px;"/>
        </GridPane>
    </TitledPane>

    <!-- Photo Section -->
    <VBox spacing="5" alignment="CENTER">
        <Label text="Profile Photo"/>
        <ImageView fx:id="photoView" fitHeight="100" fitWidth="100" preserveRatio="true" 
                   style="-fx-border-color: #BDBDBD; -fx-border-radius: 5px;"/>
        <Button text="Select Image" onAction="#handleSelectImage" 
                style="-fx-background-radius: 5px;"/>
    </VBox>

    <!-- Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" 
                style="-fx-background-radius: 5px; -fx-min-width: 80px;"/>
        <Button fx:id="saveButton" text="Save" onAction="#handleSave"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5px; -fx-min-width: 80px;"/>
    </HBox>
</VBox>