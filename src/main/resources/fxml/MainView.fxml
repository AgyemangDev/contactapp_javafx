<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="main-view-container" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.isen.java2.view.MainController">

    <!-- Top toolbar -->
         <top>
    <HBox styleClass="main-toolbar" spacing="16" alignment="CENTER_LEFT">


        <Label styleClass="app-title"
               text="📇 Contact Manager"
               onMouseClicked="#handleHome"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="🔍 Search contacts..."  styleClass="search-field"/>

    </HBox>
</top>


    <!-- Center table - FULLY RESPONSIVE -->
    <center>

        <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16" />
            </padding>
            
            <TableView fx:id="personTable" styleClass="contacts-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" maxWidth="80" minWidth="50" prefWidth="60" text="ID" />
                    <TableColumn fx:id="photoColumn" text="Photo" prefWidth="90"/>
                    <TableColumn fx:id="lastNameColumn" minWidth="100" text="Last Name" />
                    <TableColumn fx:id="firstNameColumn" minWidth="100" text="First Name" />
                    <TableColumn fx:id="nicknameColumn"
             text="Nickname"
             minWidth="40"
             prefWidth="85"/>
                    <TableColumn fx:id="phoneColumn" minWidth="120" text="Phone" />
                    <TableColumn fx:id="emailColumn" minWidth="150" text="Email" />
                    <TableColumn fx:id="addressColumn" minWidth="150" text="Address" />
                    <TableColumn fx:id="birthDateColumn"
             text="Birthdate"
             minWidth="110"
             prefWidth="120"/>
                    <TableColumn fx:id="actionColumn"
             text="Actions"
             minWidth="160"
             prefWidth="170"
             maxWidth="200"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- Bottom action bar -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="bottom-action-bar">
            <Label fx:id="contactCountLabel" styleClass="contact-count" text="Total Contacts: 0" />
            <Region HBox.hgrow="ALWAYS" />


            <Button onAction="#handleAdd" styleClass="button-success" text="➕ Add Contact" />

        </HBox>
    </bottom>
</BorderPane>
