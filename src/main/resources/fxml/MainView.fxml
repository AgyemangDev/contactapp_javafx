<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.isen.java2.view.MainController"
            stylesheets="@../css/main-view.css"
            styleClass="main-view-container">

    <!-- Top toolbar -->
    <top>
        <ToolBar styleClass="main-toolbar">
            <Label text="📇 Contact Manager" styleClass="app-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="🔍 Search contacts..."/>
        </ToolBar>
    </top>

    <!-- Center table - FULLY RESPONSIVE -->
    <center>
        <VBox VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            
            <TableView fx:id="personTable"
           styleClass="contacts-table"
           VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" minWidth="50" prefWidth="60" maxWidth="80"/>
                    <TableColumn fx:id="firstNameColumn" text="First Name" minWidth="100"/>
                    <TableColumn fx:id="lastNameColumn" text="Last Name" minWidth="100"/>
                    <TableColumn fx:id="nicknameColumn" text="Nickname" minWidth="80"/>
                    <TableColumn fx:id="phoneColumn" text="Phone" minWidth="120"/>
                    <TableColumn fx:id="emailColumn" text="Email" minWidth="150"/>
                    <TableColumn fx:id="addressColumn" text="Address" minWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- Bottom action bar -->
    <bottom>
        <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="bottom-action-bar">
            <Label text="Total Contacts: 0" fx:id="contactCountLabel" styleClass="contact-count"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="addButton" text="➕ Add Contact" onAction="#handleAdd" styleClass="button-success"/>
        </HBox>
    </bottom>
</BorderPane>