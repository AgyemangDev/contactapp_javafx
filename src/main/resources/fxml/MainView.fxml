<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.isen.java2.controller.MainController">

    <!-- Top toolbar -->
    <top>
        <ToolBar>
            <Label text="Contact Manager" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Search..." />
        </ToolBar>
    </top>

    <!-- Center table -->
    <center>
        <TableView fx:id="personTable">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="firstNameColumn" text="First Name" prefWidth="120"/>
                <TableColumn fx:id="lastNameColumn" text="Last Name" prefWidth="120"/>
                <TableColumn fx:id="nicknameColumn" text="Nickname" prefWidth="100"/>
                <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="120"/>
                <TableColumn fx:id="emailColumn" text="Email" prefWidth="150"/>
            </columns>
        </TableView>
    </center>

    <!-- Bottom buttons -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10;">
            <Button fx:id="addButton" text="Add Person" onAction="#handleAdd" 
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-min-width: 100px;"/>
        </HBox>
    </bottom>
</BorderPane>